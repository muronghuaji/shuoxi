{
  "name": "shuoxi",
  "private": true,
  "version": "3.38.2",
  "type": "module",
  "description": "本地优先的 AI 长篇小说写作工作台。",
  "author": "Shuoxi",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-smoke.cjs",
    "test:e2e:backup": "node scripts/e2e-backup-restore.cjs",
    "test:e2e:save": "node scripts/e2e-save-persistence.cjs",
    "test:e2e:find": "node scripts/e2e-find-replace.cjs",
    "bench:storage": "node scripts/story-storage-benchmark.cjs",
    "test:longrun": "vitest run --config vitest.longrun.config.ts",
    "check": "tsc --noEmit && vitest run && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "pack:dir": "vite build && electron-builder --win dir",
    "dist": "vite build && electron-builder --win nsis"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "playwright-core": "1.49.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "2.1.8"
  },
  "build": {
    "appId": "com.shuoxi.app",
    "productName": "Shuoxi",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "说戏",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "说戏",
      "unicode": true
    },
    "artifactName": "Shuoxi-${version}-setup.${ext}",
    "forceCodeSigning": false
  },
  "productName": "Shuoxi"
}
